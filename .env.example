# .env.example - copy to the repository root as .env for Docker Compose.
# The default stack starts the dashboard, Postgres, and the Ollama container.
# PRIMARY_LLM_MODEL selects the Ollama model pulled and warmed at startup.
# Docker Model Runner and OpenLLM are additional, optional endpoints.

COMPOSE_PROJECT_NAME=motor-pool
AGENT_BOARD_ENABLE_DOCKER_CONTROL=false # enable only with the trusted-local Docker-control overlay

# Database
POSTGRES_DB=agent_board
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent

# Ollama startup model and keep-alive. The default Compose stack always starts Ollama.
PRIMARY_LLM_MODEL=llama3.1:8b-instruct-q4_K_M
OLLAMA_KEEP_ALIVE=30m
OLLAMA_CONTEXT_LENGTH=16384

# Optional Docker Model Runner endpoint models.
DOCKER_RUNNER_MODEL=ai/qwen3-coder:latest
GLM_FLASH_MODEL=ai/glm-4.7-flash:latest

# OpenLLM (BentoML) - second OpenAI-compatible endpoint for custom/fine-tuned models
# Enable with: OPENLLM_ENABLED=true OPENLLM_MODEL=<hf-repo-id> docker compose --env-file .env -f config/docker-compose.yml --profile openllm up -d llm_openllm
OPENLLM_ENABLED=false
OPENLLM_MODEL=

# 9router - OpenAI-compatible endpoint for Anthropic/Claude models
# Runs on host port 20128, accessed via host.docker.internal from containers
# Set NINEROUTER_API_KEY to enable
NINEROUTER_URL=http://host.docker.internal:20128
# NINEROUTER_MODEL must match a combo/model returned by GET /v1/models on your instance.
# "MAX" is an example combo name, not a universal default.
NINEROUTER_MODEL=MAX
NINEROUTER_API_KEY=

# Device profile controls the dashboard's profile-aware endpoint/model guidance.
# The detector currently reads NVIDIA VRAM plus system RAM; AMD/runtime detection is tracked in issue #117.
DEVICE_PROFILE=minimal

# The Compose default is llama3.1:8b-instruct-q4_K_M. Set PRIMARY_LLM_MODEL explicitly to use another model.

# Custom LLM endpoints — add OpenRouter, vLLM, LM Studio, or any OpenAI-compatible API here.
# JSON array; each entry is merged into the endpoint registry alongside Ollama + Docker Runner.
# Fields: key (required), url (required), name, apiKey, defaultModel, type, apiStyle
# Example (OpenRouter):
# CUSTOM_LLM_ENDPOINTS=[{"key":"openrouter","name":"OpenRouter","url":"https://openrouter.ai/api/v1","apiKey":"sk-or-v1-...","defaultModel":"anthropic/claude-3-haiku","type":"cloud"}]
CUSTOM_LLM_ENDPOINTS=

# Workspace file I/O — mount a host project folder into the agent-dashboard container.
# Apply config/docker-compose.workspace.yml overlay to activate the mount.
# WORKSPACE_PATH: absolute host path to mount (Windows: C:/Users/you/code/my-project)
# Git author identity for agent commits (optional; defaults to motor-pool/agent@board.local):
WORKSPACE_PATH=
#GIT_AUTHOR_NAME=motor-pool
#GIT_AUTHOR_EMAIL=agent@board.local
# MCP tool servers backing the Content Studio / Website Agent experiences (compose profile `tools`)
# Enable with: docker compose --env-file .env -f config/docker-compose.yml --profile tools up -d tool-content-gen tool-website tool-tokeneconomizer
#TOOL_CONTENT_GEN_URL=http://tool-content-gen:3200
#TOOL_WEBSITE_URL=http://tool-website:3201
#TOKEN_ECONOMIZER_URL=http://tool-tokeneconomizer:3202
# TE_PYTHON=python3  # Path to python3 executable for te CLI
# TOKEN_ECONOMIZER_DATA_DIR=~/.tokeneconomizer  # Host path for TokenEconomizer learned data

# BB MCP server (Blackboard's Model Control Plane for federated learning and model sharing) — compose profile `bb-mcp`
BB_MCP_ENABLED=false

# OpenTelemetry tracing — requires the `observability` compose profile (Jaeger).
# Enable with: OTEL_ENABLED=true docker compose --env-file .env -f config/docker-compose.yml --profile observability up -d jaeger
OTEL_ENABLED=false
# OTEL_ENDPOINT=http://jaeger:4318
# LOG_LEVEL=info

# Tool: Content Gen (MCP)
MPT_API_URL=http://host.docker.internal:8080
MPT_UI_URL=http://host.docker.internal:8501
MONEYPRINTERTURBO_COMPOSE=/workspace-root/content-gen/MoneyPrinterTurbo/docker-compose.yml

# Tool: Website (MCP)
YELP_API_KEY=
GOOGLE_PLACES_API_KEY=
NETLIFY_AUTH_TOKEN=
YOUR_NAME=
YOUR_COMPANY=Your Web Agency
YOUR_EMAIL=
YOUR_PHONE=

# Compose profile reference:
#   (default)       agent-db + ollama + agent-dashboard only — minimal, fits a 16 GB host
#   observability   + jaeger tracing UI (port 16686)
#   sandbox         + nemoclaw safety sandbox (port 9000) — currently deferred, crash-loops on Windows
#   bb-mcp          + Blackboard MCP server (port 3100)
#   tools           + content-gen + website MCP tool servers (ports 3200/3201)
#   openllm         + OpenLLM custom-model endpoint (port 8082) — deferred, GPU-only catalog
#   warmup          + ollama-warmup (pre-loads primary model at stack start)
#   gpu             apply config/docker-compose.gpu.yml overlay for CUDA passthrough
