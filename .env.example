# .env.example - place into config/.env to configure the motor-pool Docker Compose environment.
# ========== LLM STARTUP STRATEGIES ==========
# Use one of these based on available system resources:

# STRATEGY 1: Docker Model Runner only (lowest memory, recommended default)
# docker compose -f config/docker-compose.yml up -d agent-dashboard
# - Uses Docker Desktop's built-in model runner (ai/qwen3-coder, ai/glm-4.7-flash)
# - No container overhead, models run on host GPU (if available)
# - Best for: dev machines, limited RAM

# STRATEGY 2: Ollama only (high-memory, local model)
# ACTIVE_LLM_BACKEND=ollama docker compose -f config/docker-compose.yml --profile llm-ollama up -d
# - Ollama in container with llama3.2:3b model
# - ~8GB RAM minimum, requires GPU for speed
# - Best for: dedicated servers, high-end workstations

# STRATEGY 3: OpenLLM custom models (for HuggingFace models)
# ACTIVE_LLM_BACKEND=openllm OPENLLM_ENABLED=true OPENLLM_MODEL=meta-llama/Meta-Llama-3.1-8B docker compose -f config/docker-compose.yml --profile openllm up -d
# - Custom HuggingFace models via BentoML
# - Flexible model selection
# - Best for: specific model requirements, fine-tuned variants

# NOTE: Only one PRIMARY backend should be active to minimize memory usage.
# Dashboard logic should detect ACTIVE_LLM_BACKEND and route requests accordingly.

COMPOSE_PROJECT_NAME=motor-pool
AGENT_BOARD_ENABLE_DOCKER_CONTROL=true # adds Docker control for internal model runner containers in the dashboard UI

# Database
POSTGRES_DB=agent_board
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent

# Ollama
OLLAMA_HOST=0.0.0.0:8080

# LLM Selection: which backend to use
# Options: ollama, docker-model-runner, openllm
# Only one should be active at a time to reduce memory overhead
ACTIVE_LLM_BACKEND=docker-model-runner

# Ollama config (used when ACTIVE_LLM_BACKEND=ollama)
PRIMARY_LLM_MODEL=llama3.2:3b
OLLAMA_KEEP_ALIVE=30m

# Docker Model Runner config (used when ACTIVE_LLM_BACKEND=docker-model-runner)
DOCKER_RUNNER_MODEL=ai/qwen3-coder:latest
GLM_FLASH_MODEL=ai/glm-4.7-flash:latest

# OpenLLM config (used when ACTIVE_LLM_BACKEND=openllm)

# OpenLLM (BentoML) - second OpenAI-compatible endpoint for custom/fine-tuned models
# Enable with: OPENLLM_ENABLED=true OPENLLM_MODEL=<hf-repo-id> docker compose --profile openllm up -d llm_openllm
OPENLLM_ENABLED=false
OPENLLM_MODEL=

# Device profile: drives default model selection based on hardware tier.
# Run scripts/detect-profile.ps1 to auto-detect your hardware and write this value.
# Options: minimal (CPU-only / <4 GB VRAM), laptop (mid-GPU e.g. RTX 3070), desktop (high-GPU e.g. RTX 4080)
# When set, the profile's recommended model is used as PRIMARY_LLM_MODEL unless that var is also set.
DEVICE_PROFILE=minimal

# Primary Ollama model served by the `primary` endpoint (must be pulled into the ollama container).
# If unset, the active DEVICE_PROFILE's general-task model is used.
# Profile defaults: minimal=llama3.2:1b  laptop=llama3.2:3b  desktop=llama3.1:8b
PRIMARY_LLM_MODEL=

# Custom LLM endpoints — add OpenRouter, vLLM, LM Studio, or any OpenAI-compatible API here.
# JSON array; each entry is merged into the endpoint registry alongside Ollama + Docker Runner.
# Fields: key (required), url (required), name, apiKey, defaultModel, type, apiStyle
# Example (OpenRouter):
# CUSTOM_LLM_ENDPOINTS=[{"key":"openrouter","name":"OpenRouter","url":"https://openrouter.ai/api/v1","apiKey":"sk-or-v1-...","defaultModel":"anthropic/claude-3-haiku","type":"cloud"}]
CUSTOM_LLM_ENDPOINTS=

# Workspace file I/O — mount a host project folder into the agent-dashboard container.
# Apply config/docker-compose.workspace.yml overlay to activate the mount.
# WORKSPACE_PATH: absolute host path to mount (Windows: C:/Users/you/code/my-project)
# Git author identity for agent commits (optional; defaults to motor-pool/agent@board.local):
WORKSPACE_PATH=
#GIT_AUTHOR_NAME=motor-pool
#GIT_AUTHOR_EMAIL=agent@board.local
# MCP tool servers backing the Content Studio / Website Agent experiences (compose profile `tools`)
# Enable with: docker compose -f config/docker-compose.yml --profile tools up -d tool-content-gen tool-website
#TOOL_CONTENT_GEN_URL=http://tool-content-gen:3200
#TOOL_WEBSITE_URL=http://tool-website:3201

# BB MCP server (Blackboard's Model Control Plane for federated learning and model sharing) — compose profile `bb-mcp`
BB_MCP_ENABLED=false

# OpenTelemetry tracing — requires the `observability` compose profile (Jaeger).
# Enable with: OTEL_ENABLED=true docker compose --profile observability up -d jaeger
OTEL_ENABLED=false
# OTEL_ENDPOINT=http://jaeger:4318
# LOG_LEVEL=info

# Tool: Content Gen (MCP)
MPT_API_URL=http://host.docker.internal:8080
MPT_UI_URL=http://host.docker.internal:8501
MONEYPRINTERTURBO_COMPOSE=/workspace-root/content-gen/MoneyPrinterTurbo/docker-compose.yml

# Tool: Website (MCP)
YELP_API_KEY=
GOOGLE_PLACES_API_KEY=
NETLIFY_AUTH_TOKEN=
YOUR_NAME=
YOUR_COMPANY=Your Web Agency
YOUR_EMAIL=
YOUR_PHONE=

# Compose profile reference:
#   (default)       agent-db + ollama + agent-dashboard only — minimal, fits a 16 GB host
#   observability   + jaeger tracing UI (port 16686)
#   sandbox         + nemoclaw safety sandbox (port 9000) — currently deferred, crash-loops on Windows
#   bb-mcp          + Blackboard MCP server (port 3100)
#   tools           + content-gen + website MCP tool servers (ports 3200/3201)
#   openllm         + OpenLLM custom-model endpoint (port 8082) — deferred, GPU-only catalog
#   warmup          + ollama-warmup (pre-loads primary model at stack start)
#   gpu             apply config/docker-compose.gpu.yml overlay for CUDA passthrough
