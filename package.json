{
  "name": "motor-pool",
  "version": "1.0.0",
  "description": "motor-pool is a local-first control room for multi-model AI workflows. It gives you a chat surface, safety rails, and live observability in one place, so you can run and evaluate model behavior without sending data to external APIs.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "eslint .",
    "test:journeys": "playwright test --config config/playwright.journeys.config.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitsuah/motor-pool.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/nitsuah/motor-pool/issues"
  },
  "homepage": "https://github.com/nitsuah/motor-pool#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "vitest": "^5.0.5"
  }
}
