{
  "_comment": "TokenEconomizer plugin. Wraps Microsoft's TokenEconomizer CLI as HTTP tools. Operators must install TokenEconomizer locally (install via git clone + sign-in) and expose Python path. Ships disabled so operators opt in. See docs/API.md#plugins.",
  "manifestVersion": 1,
  "name": "tokeneconomizer",
  "version": "1.0.0",
  "description": "Token cost optimization plugin using Microsoft TokenEconomizer. Learns from past sessions, prunes unused tools, detects stuck loops. Requires local TokenEconomizer installation via https://github.com/microsoft/TokenEconomizer.",
  "enabled": false,
  "baseUrl": "${TOKEN_ECONOMIZER_URL:-http://tool-tokeneconomizer:3202}",
  "tools": [
    {
      "name": "status",
      "description": "Show TokenEconomizer status: learned facts, actions, costs (read-only).",
      "transport": "http",
      "method": "POST",
      "path": "/status",
      "timeoutMs": 30000,
      "parameters": {
        "type": "object",
        "properties": {
          "json": {
            "type": "boolean",
            "description": "return machine-readable output"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "microskills",
      "description": "List injected and forming facts from micro-skills (read-only).",
      "transport": "http",
      "method": "POST",
      "path": "/microskills",
      "timeoutMs": 30000,
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "toolprune",
      "description": "Show the proposed tool deny list and evidence, or measure it. Apply/restore/refresh are disabled over HTTP.",
      "transport": "http",
      "method": "POST",
      "path": "/toolprune",
      "timeoutMs": 30000,
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "show",
              "measure"
            ],
            "description": "read-only tool pruning action (default show)"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "config",
      "description": "Show TokenEconomizer config (read-only; set/unset are disabled over HTTP).",
      "transport": "http",
      "method": "POST",
      "path": "/config",
      "timeoutMs": 30000,
      "parameters": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "show"
            ],
            "description": "config action (default show)"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "repomap",
      "description": "Show representation map for current repository.",
      "transport": "http",
      "method": "POST",
      "path": "/repomap",
      "timeoutMs": 60000,
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "repos",
      "description": "List repositories with TokenEconomizer state (read-only; migrate/merge are disabled over HTTP).",
      "transport": "http",
      "method": "POST",
      "path": "/repos",
      "timeoutMs": 60000,
      "parameters": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "list"
            ],
            "description": "repo operation (default list)"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "doctor",
      "description": "Run diagnostics on TokenEconomizer installation.",
      "transport": "http",
      "method": "POST",
      "path": "/doctor",
      "timeoutMs": 60000,
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  ],
  "events": {
    "channel": "plugins",
    "emits": [
      "tokeneconomizer.invoked",
      "tokeneconomizer.failed"
    ]
  }
}
